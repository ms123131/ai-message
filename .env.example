# Переменные для docker compose. Скопируйте в .env и заполните для production.

# Postgres
POSTGRES_USER=aimessage
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aimessage

# API
APP_ENV=production
JWT_SECRET=please-generate-a-long-random-string
# Fernet-ключ для шифрования секретов интеграций в БД (client_secret,
# access/refresh токены). Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# При ротации можно перечислить несколько ключей через запятую — первый
# активный (им шифруем при записи), остальные для расшифровки старых записей.
ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:8080

# Bitrix24 — параметры НАШЕГО тиражного приложения. Одно приложение на всех
# клиентов; токены для каждого конкретного портала приходят в /install/bitrix24
# и хранятся в БД.
BITRIX24_APP_CLIENT_ID=
BITRIX24_APP_CLIENT_SECRET=

# Web
WEB_PORT=8080
# Публичный URL приложения (нужен для event.bind handler).
# В dev обычно ngrok: WEBHOOK_BASE_URL=https://<random>.ngrok-free.app
WEBHOOK_BASE_URL=
# При сборке VITE_API_URL вшивается в бандл. По умолчанию пусто — фронт
# ходит на тот же origin (`/api/v1/...`), nginx проксирует на api:8000.
# Переопределите, только если фронт и API на разных доменах.
VITE_API_URL=
