# Переменные для docker compose. Скопируйте в .env и заполните для production.

# Postgres
POSTGRES_USER=aimessage
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aimessage

# API
APP_ENV=production
JWT_SECRET=please-generate-a-long-random-string
CORS_ORIGINS=http://localhost:8080

# Web
WEB_PORT=8080
# При сборке VITE_API_URL вшивается в бандл. По умолчанию /api (через nginx-прокси).
VITE_API_URL=/api
