# Окружение
APP_ENV=development

# База данных (на старте — SQLite, для production — Postgres)
DATABASE_URL=sqlite+aiosqlite:///./data/ai-message.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ai_message

# CORS — список разрешённых origin'ов фронтенда через запятую
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT-секрет (в production обязательно задать)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_MIN=60

# Bitrix24 OAuth — секреты приложений хранятся в БД per-tenant.
# Здесь только дефолтные значения для одного приложения (если используется глобальное).
# BITRIX24_CLIENT_SECRET=
# BITRIX24_OAUTH_TOKEN_URL=https://oauth.bitrix24.tech/oauth/token/
